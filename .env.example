# Client Environment Configuration Template
# Never place server secrets (MONGODB_URI, JWT_SECRET) in client VITE_* variables.
# Backend server environment variables belong in server/.env (see server/.env.example).

# Backend API origin or base URL; the client adds /api exactly once.
# - Local development: set to http://localhost:5000 (or leave unset to use the Vite /api dev proxy).
# - Production (required): set to the deployed backend HTTPS origin before building.
VITE_API_BASE_URL=http://localhost:5000

# Public HTTPS origin used for marketing-page canonical and social URLs.
# Set this to the real production frontend origin at build/deploy time; use the origin only (no path).
# When unset or invalid (including local HTTP), absolute URL tags are omitted intentionally.
VITE_SITE_URL=

# Public Google OAuth web client ID for the Sign in with Google button; never put a client secret here.
VITE_GOOGLE_CLIENT_ID=
