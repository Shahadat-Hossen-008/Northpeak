# Server Environment Configuration Template
# Keep this file and its values strictly on the backend server.

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP listener port (use host-provided PORT in production)
PORT=5000

# MongoDB connection string (production requires a replica set / Atlas cluster for transactions)
MONGODB_URI=mongodb://localhost:27017/northpeak

# JWT signing secret (required in production; must be at least 32 cryptographically random characters)
JWT_SECRET=northpeak_super_secret_jwt_key_2026_dev_fallback

# Comma-separated allowlist of exact client origins (HTTPS required in production; wildcard * is forbidden)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Enable only when running behind a trusted reverse proxy / load balancer (e.g. Render, Railway, Fly, Nginx)
TRUST_PROXY=false

# Google Identity Services (use the same OAuth web client ID in the frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Backend production needs both values for registration and resend verification emails.
# EMAIL_FROM must use a sender address on a domain verified with Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Optional periodic assignment reconciler interval in milliseconds (default: 300000; 0 disables)
RECONCILE_INTERVAL_MS=300000
